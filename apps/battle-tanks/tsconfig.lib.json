{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "./out-tsc/lib",
    "declarationMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@neon-cabinet/audio-tools": ["libs/audio-tools/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../../libs/typed-event-emitter/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shaders/tsconfig.lib.json"
    },
    {
      "path": "../../libs/model-tools"
    },
    {
      "path": "../../libs/audio-tools/tsconfig.lib.json"
    }
  ]
}
